VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only (no VITE_ prefix): read by the /api/ors functions, never sent to the browser
ORS_API_KEY=your_openrouteservice_api_key
# Server-only, for the portfolio demo sandboxes (api/demo/*). The service-role
# key bypasses row-level security: set it in Vercel only, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/daily
CRON_SECRET=
